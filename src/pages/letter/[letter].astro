---
import { letters } from '@/lib/private-letters'

// Cover letters are private, print-oriented materials. Keep their stable URLs
// available while developing, but never emit them in the production site.
// getStaticPaths runs in its own scope, so it can only use imports (not frontmatter consts).
export function getStaticPaths() {
  if (import.meta.env.PROD) return []

  return Object.keys(letters).map((letter) => ({
    params: { letter },
  }))
}

const { letter } = Astro.params
const Letter = letters[letter as string]
---

<Letter />
